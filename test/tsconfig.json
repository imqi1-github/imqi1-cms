{
  // 独立一份 test/tsconfig:Nuxt prepare 会重写 .nuxt/tsconfig.*,直接改会被覆盖
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["bun-types"],
    "paths": {
      "#shared": ["../shared"],
      "#shared/*": ["../shared/*"],
      "#server/*": ["../server/*"],
      "@/*": ["../app/*"],
      "~~": [".."],
      "~~/*": ["../*"],
      "#test/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["./**/*.ts", "./types/*.d.ts", "../shared/**/*.d.ts"],
  "exclude": ["node_modules", "../node_modules"]
}
