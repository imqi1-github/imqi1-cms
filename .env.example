# ============================================
# 全局说明：NODE_ENV
# ============================================
# NODE_ENV 不在此文件配置，由运行环境设置（宝塔 / PM2 / Docker 镜像预设 production）。
# 生产必须为完整单词 production（写 prod / 留空会被当作非生产处理）：referer / 小程序
# 签名校验会跳过、上传目录解析错误、CDN / ISR / cookie secure 不生效。构建期 nuxt build
# 会自动强制 production；裸机启动 node .output/server/index.mjs 需自行设置 NODE_ENV=production。

# ============================================
# 数据库连接（PostgreSQL）【运行时 / 部署脚本】
# ============================================

# 用于 Prisma Postgres Adapter (应用运行时)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="your_username"
DB_PASSWORD="your_password"
DB_NAME="your_database_name"

# ============================================
# Redis 缓存配置（可选，用于 ISR 增量缓存 + 搜索缓存）【构建期】
# ============================================
# 未配置（REDIS_HOST_* 为空）时不报错：ISR 自动降级到文件系统缓存，搜索缓存关闭
# 开发环境使用 REDIS_*_DEV 系列
# 生产环境使用 REDIS_*_PROD 系列

# 开发环境 Redis 配置
# REDIS_HOST_DEV=""
# REDIS_PORT_DEV="6379"
# REDIS_PASSWORD_DEV=""
# REDIS_DB_DEV="0"

# 生产环境 Redis 配置
# 启用 Redis 时 REDIS_HOST_PROD 填 redis（compose 服务名，非空即烘焙 redis:6379）；留空则不启用
REDIS_HOST_PROD=""
REDIS_PORT_PROD="6379"
REDIS_PASSWORD_PROD=""
REDIS_DB_PROD="0"

# ============================================
# 腾讯云 COS 上传配置【部署脚本：构建产物上传】
# ============================================
# 仅用于 scripts/upload-cos.mjs（npm run upload:cos）把 .output 构建产物上传到 COS。
# 注意：后台「附件存储」用的 COS 密钥不在这里，而是在后台设置 → 数据库 informations 表
#       （server/utils/cos.ts 读取），与下方变量无关。

# COS 密钥配置
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""

# COS 上传路径前缀（可选）
COS_PREFIX=""
# 上传并发数
COS_CONCURRENCY=20

# ============================================
# 本地上传存储目录（可选）【运行时】
# ============================================
UPLOADS_DIR=""

# ============================================
# 实况照片压缩工具（可选）【部署脚本】
# ============================================

# scripts/compress-livephoto.mjs 使用的 ffmpeg 可执行文件路径
# 不配置时按以下顺序查找:ffmpeg-static 包 → 系统 PATH 中的 ffmpeg
# Windows 示例: "C:/ffmpeg/bin/ffmpeg.exe"
# 留空则依赖系统 PATH 或 ffmpeg-static
FFMPEG_PATH=""

# ============================================
# 高德地图 JS API 配置（旅行地图功能，可选）【运行时】
# key / securityCode 均为运行时读取，不烘焙进构建产物：
# - 代理模式（生产默认）：浏览器不持 key，由服务端 /_AMapService 注入，运行环境设这两个变量即可生效，无需重新打包。
# - 直连模式（开发环境恒直连）：浏览器需 key 加载高德 JS，同样运行时从环境变量读取。
# ============================================
AMAP_KEY=""
AMAP_SECURITY_CODE=""

# ============================================
# SSR 内部请求配置（可选）【运行时】
# ============================================
# 生产环境建议填写一串随机长字符串，用于服务端 SSR 请求绕过 referer 校验。
# 未配置时会兼容旧的 x-ssr-internal-request: true 行为，避免旧部署失效。
SSR_INTERNAL_REQUEST_SECRET=""

# ============================================
# 登录安全（可选）【运行时】
# ============================================
# 签「两步验证 challenge」与「信任此设备」cookie 的 HMAC 密钥。
# 建议生产环境填一串随机长字符串；留空时回退用 SSR_INTERNAL_REQUEST_SECRET，
# 两者都空则每次进程启动随机生成（信任设备 cookie 会随重启失效）。
LOGIN_SECRET=""

# ============================================
# 小程序 API 鉴权配置（可选）【运行时】
# ============================================
# 用于 /api/mini/* 的 HMAC-SHA256 签名校验密钥（GET/POST 等所有方法）。
# 客户端与服务端共享此密钥，对 `METHOD\nPATH\ntimestamp\nnonce` 做 HMAC-SHA256 签名。
# 未配置（留空）时不启用鉴权，兼容旧部署；开发环境（NODE_ENV=development）始终跳过校验。
# 生产环境建议填写一串随机长字符串。
MINI_API_SECRET=""


# ============================================
# 微信小程序码（可选，用于「文章小程序端看」）【构建期】
# ============================================
# 配置后，/api/mini/qrcode 才能生成小程序码；留空则该接口返回 404。
# 在小程序后台「开发管理 → 开发设置」获取 AppID 与 AppSecret。
WECHAT_MINI_APPID=""
WECHAT_MINI_SECRET=""


# ============================================
# 上传至服务器配置【部署脚本】
# ============================================
# 供 scripts/upload-server.mjs（npm run upload:server）把构建产物上传到生产服务器。
# 旧名 SERVER_IP / SERVER_USERNAME 仍兼容（作为别名读取），新配置请用以下主名。
SERVER_HOST=""
SERVER_PORT="22"
SERVER_USER="root"
SERVER_PASSWORD=""
SERVER_UPLOAD_DIR=""
# 上传并发数（不配置默认 8）
SERVER_UPLOAD_CONCURRENCY="8"

# ============================================
# 生产部署目标配置【部署脚本：scripts/generate-nginx-conf.mjs】
# ============================================
# 用于 npm run nginx:generate 生成 Nginx 配置片段（宝塔面板）。
# 注意：这里 _PROD 语义是「单份的生产部署目标」，与上方 Redis 的 REDIS_*_DEV/_PROD
#      「同一配置的双环境双份」不同，故统一用 DEPLOY_ 前缀区分。
DEPLOY_PORT=3000
DEPLOY_PROJECT_ROOT_DIR=/www/wwwroot/glass
DEPLOY_SITE_DOMAIN=imqi1.com
DEPLOY_CDN_DOMAIN=cdn.imqi1.com
# 是否启用 CDN 静态资源重定向（将静态资源 301 跳转到 CDN）
# 如果你的 CDN 已经配置了镜像回源，可以保持禁用
DEPLOY_ENABLE_CDN_REDIRECT=true

# 恢复真实客户端 IP（provider 无关，适配任意 CDN/云接入/负载均衡）。
# 当源站前还有一层接入层时，nginx 的 $remote_addr 是「回源节点 IP」而非访客 IP，
# 会导致评论入库 IP / 足迹去重 / 限流键全部塌缩成接入层节点 IP。填了下面这个才启用 real_ip 恢复。
#   DEPLOY_TRUSTED_PROXY：前端接入层的「回源 IP 段」，逗号分隔（支持单个 IP 或 CIDR）。
#       任意一家的接入层填各自回源段即可；若源站防火墙只对接入层开放（外部无法直连源站），
#       可填 0.0.0.0/0（信任所有转发头，安全前提是外部直连源站被阻断）。
#   DEPLOY_REAL_IP_HEADER：接入层把真实客户端写在哪个头（默认 X-Forwarded-For，几乎全行业通用；
#       Cloudflare 用 CF-Connecting-IP 等可覆盖）。腾讯云/阿里云 CDN 默认走 X-Forwarded-For。
# 留空则不恢复真实 IP（评论等会记录成接入层节点 IP）。
DEPLOY_TRUSTED_PROXY=""
DEPLOY_REAL_IP_HEADER="X-Forwarded-For"

# ============================================
# 纯真 IP 库路径（可选）【运行时 / 部署脚本】
# ============================================
# 访客 IP 定位（server/utils/qqwry.ts 等）使用的 qqwry.ipdb 文件路径。
# 不配置时使用打包内的 qqwry.ipdb（postbuild 已拷贝到 .output）。
QQWRY_IPDB_PATH=""

# ============================================
# 宝塔面板 API 配置（可选）【部署脚本】
# ============================================
# 供 scripts/restart-server.mjs、scripts/clear-redis.mjs 调用宝塔面板 API 使用。
BT_PANEL_URL=""
BT_API_KEY=""
BT_PROJECT_NAME=""
