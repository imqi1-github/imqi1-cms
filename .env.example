# ============================================
# 配置分层总览
# ============================================
# 本文件内变量按「读取时机」分三类，各段标题里已标注：
#   【构建期】    nuxt build 打包时读取并写入产物；部署后改环境变量无效，必须重新打包。
#   【运行时】    Node 服务启动后读取；部署环境可用 NUXT_* 前缀的同名变量覆盖默认值
#                 （例：运行时设 NUXT_AMAP_KEY 可覆盖 AMAP_KEY），无需重新打包。
#   【部署脚本】  scripts/* 下的工具脚本（upload-cos / upload-server / nginx 生成等）按需读取。
# 注意：数据库/后台可改的运行时配置（站点名、后台附件 COS 密钥等）不在此文件，
#       见后台设置 → 数据库 informations 表。

# ============================================
# 数据库连接（MySQL / MariaDB）【运行时 / 部署脚本】
# ============================================

# 用于 Prisma MariaDB Adapter (应用运行时)
# 注意：Adapter 使用拆分的参数，不支持 connection string
# 需连库的 Prisma 命令（prisma studio / db execute 等）也复用这套变量：
#   prisma.config.ts 会用 DB_* 拼接连接串注入，无需再单独配置 DATABASE_URL。
#   （若确需覆盖，可显式设置 DATABASE_URL，它会优先生效。）
# Docker 部署：compose 会用 DB_USER/DB_PASSWORD 通过 MYSQL_USER/MYSQL_PASSWORD 自动创建该用户，
#              并授予 DB_NAME 库的全部权限；应用与 healthcheck 均用此账户，不使用 root。
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="nodejs"
DB_PASSWORD="your_password"
DB_NAME="your_database_name"

# ============================================
# Redis 缓存配置（可选，用于 ISR 增量缓存 + 搜索缓存）【构建期】
# ============================================
#
# 【构建期】nuxt build 打包时按 NODE_ENV 读取 REDIS_*_DEV（开发）或 REDIS_*_PROD（生产）
#   系列并烘焙进产物，ISR 缓存（nitro storage/routeRules）与搜索缓存（runtimeConfig）共用。
#   改 prod 值后需重新打包才会生效。
# 生产服务器运行环境不要再设置任何 Redis 环境变量（REDIS_*_PROD / NUXT_REDIS_*），
#   以免与打包时的 dev/prod 分支设计冲突、徒增变量种类。
# 未配置（REDIS_HOST_* 为空）时不报错：ISR 自动降级到文件系统缓存，搜索缓存关闭。
#
# 开发环境使用 REDIS_*_DEV 系列
# 生产环境使用 REDIS_*_PROD 系列
# Docker 部署是否启用 Redis：用 docker/ 下带 Redis 的 compose 版本 + 本段 PROD 变量即可
#   （无需其它变量，详见 docker/README.md）。

# 开发环境 Redis 配置
# REDIS_HOST_DEV=""
# REDIS_PORT_DEV="6379"
# REDIS_PASSWORD_DEV=""
# REDIS_DB_DEV="0"

# 生产环境 Redis 配置
# 启用 Redis 时 REDIS_HOST_PROD 填 redis（compose 服务名，非空即烘焙 redis:6379）；留空则不启用
REDIS_HOST_PROD=""
REDIS_PORT_PROD="6379"
REDIS_PASSWORD_PROD=""
REDIS_DB_PROD="0"

# ============================================
# 腾讯云 COS 上传配置【部署脚本：构建产物上传】
# ============================================
# 仅用于 scripts/upload-cos.mjs（npm run upload:cos）把 .output 构建产物上传到 COS。
# 注意：后台「附件存储」用的 COS 密钥不在这里，而是在后台设置 → 数据库 informations 表
#       （server/utils/cos.ts 读取），与下方变量无关。

# COS 密钥配置
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""

# COS 上传路径前缀（可选）
COS_PREFIX=""
# 上传并发数
COS_CONCURRENCY=20

# ============================================
# 本地上传存储目录（可选）【运行时】
# ============================================
# 后台附件「本地上传」时文件的存放根目录。
# 不配置时默认写入打包产物内的 .output/public/uploads，由 Nitro 静态服务直接提供。
# 可指定为任意目录（建议用绝对路径），例如挂载到独立数据盘：
#   Linux 示例:   UPLOADS_DIR=/data/uploads
#   Windows 示例: UPLOADS_DIR=D:/uploads
# 当目录位于 .output/public 之外时，读取由 /uploads/** 兜底路由提供，前端访问不受影响。
# 相对路径相对于进程启动目录（cwd）解析。
# Docker 部署：UPLOADS_DIR 作为宿主演路径（bind mount），默认 ../uploads（项目根/uploads，本地直接可见），
#   挂载到容器内固定路径 /app/.output/public/uploads；裸机部署则是应用直接写入的目录。
UPLOADS_DIR=""

# ============================================
# 实况照片压缩工具（可选）【部署脚本】
# ============================================

# scripts/compress-livephoto.mjs 使用的 ffmpeg 可执行文件路径
# 不配置时按以下顺序查找:ffmpeg-static 包 → 系统 PATH 中的 ffmpeg
# Windows 示例: "C:/ffmpeg/bin/ffmpeg.exe"
# 留空则依赖系统 PATH 或 ffmpeg-static
FFMPEG_PATH=""

# ============================================
# 高德地图 JS API 配置（旅行地图功能，可选）【构建期】
# ============================================
# 申请地址：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建「Web端(JS API)」Key
# 生产部署走服务端代理（/_AMapService）：打包时可留空，运行环境设置
#   AMAP_KEY / AMAP_SECURITY_CODE（或 NUXT_AMAP_KEY / NUXT_AMAP_SECURITY_CODE）
#   即可在运行时生效，无需重新打包。
# 开发/非代理模式（useNginxProxy.development=false）需打包时带上 key。
AMAP_KEY=""
# JS API 2.0 安全密钥（创建 Key 后，在 Key 配置页获取）
AMAP_SECURITY_CODE=""

# ============================================
# SSR 内部请求配置（可选）【运行时】
# ============================================
# 生产环境建议填写一串随机长字符串，用于服务端 SSR 请求绕过 referer 校验。
# 未配置时会兼容旧的 x-ssr-internal-request: true 行为，避免旧部署失效。
# 运行时可用 NUXT_SSR_INTERNAL_REQUEST_SECRET 覆盖。
SSR_INTERNAL_REQUEST_SECRET=""

# ============================================
# 小程序 API 鉴权配置（可选）【运行时】
# ============================================
# 用于 /api/mini/* 的 HMAC-SHA256 签名校验密钥（GET/POST 等所有方法）。
# 客户端与服务端共享此密钥，对 `METHOD\nPATH\ntimestamp\nnonce` 做 HMAC-SHA256 签名。
# 未配置（留空）时不启用鉴权，兼容旧部署；开发环境（NODE_ENV=development）始终跳过校验。
# 生产环境建议填写一串随机长字符串。
MINI_API_SECRET=""


# ============================================
# 上传至服务器配置【部署脚本】
# ============================================
# 供 scripts/upload-server.mjs（npm run upload:server）把构建产物上传到生产服务器。
# 旧名 SERVER_IP / SERVER_USERNAME 仍兼容（作为别名读取），新配置请用以下主名。
SERVER_HOST=""
SERVER_PORT="22"
SERVER_USER="root"
SERVER_PASSWORD=""
SERVER_UPLOAD_DIR=""
# 上传并发数（不配置默认 8）
SERVER_UPLOAD_CONCURRENCY="8"

# ============================================
# 生产部署目标配置【部署脚本：scripts/generate-nginx-conf.mjs】
# ============================================
# 用于 npm run nginx:generate 生成 Nginx 配置片段（宝塔面板）。
# 注意：这里 _PROD 语义是「单份的生产部署目标」，与上方 Redis 的 REDIS_*_DEV/_PROD
#      「同一配置的双环境双份」不同，故统一用 DEPLOY_ 前缀区分。
DEPLOY_PORT=3000
DEPLOY_PROJECT_ROOT_DIR=/www/wwwroot/glass
DEPLOY_SITE_DOMAIN=imqi1.com
DEPLOY_CDN_DOMAIN=cdn.imqi1.com
# 是否启用 CDN 静态资源重定向（将静态资源 301 跳转到 CDN）
# 如果你的 CDN 已经配置了镜像回源，可以保持禁用
DEPLOY_ENABLE_CDN_REDIRECT=true

# ============================================
# 纯真 IP 库路径（可选）【运行时 / 部署脚本】
# ============================================
# 访客 IP 定位（server/utils/qqwry.ts 等）使用的 qqwry.ipdb 文件路径。
# 不配置时使用打包内的 qqwry.ipdb（postbuild 已拷贝到 .output）。
QQWRY_IPDB_PATH=""

# ============================================
# 宝塔面板 API 配置（可选）【部署脚本】
# ============================================
# 供 scripts/restart-server.mjs、scripts/clear-redis.mjs 调用宝塔面板 API 使用。
BT_PANEL_URL=""
BT_API_KEY=""
BT_PROJECT_NAME=""
