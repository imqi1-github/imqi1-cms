# ============================================
# 数据库连接（MySQL / MariaDB）
# ============================================

# 用于 Prisma Migrate (prisma migrate dev)
DATABASE_URL="mysql://root:your_password@localhost:3306/your_database_name"

# 用于 Prisma MariaDB Adapter (应用运行时)
# 注意：Adapter 使用拆分的参数，不支持 connection string
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="your_database_name"

# ============================================
# Redis 缓存配置（可选，用于 ISR 缓存）
# ============================================
#
# Redis 用于存储 ISR（增量静态再生成）缓存，可显著提升性能
# 如果不配置 Redis，缓存会自动降级到文件系统存储
#
# 开发环境使用 REDIS_*_DEV 系列
# 生产环境使用 REDIS_*_PROD 系列

# 开发环境 Redis 配置
REDIS_HOST_DEV=""
REDIS_PORT_DEV="6379"
REDIS_PASSWORD_DEV=""
REDIS_DB_DEV="0"

# 生产环境 Redis 配置
REDIS_HOST_PROD=""
REDIS_PORT_PROD="6379"
REDIS_PASSWORD_PROD=""
REDIS_DB_PROD="0"

# ============================================
# 腾讯云 COS 上传配置
# ============================================

# COS 密钥配置
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""

# COS 上传路径前缀（可选）
COS_PREFIX=""
# 上传并发数
COS_CONCURRENCY=20

# ============================================
# 实况照片压缩工具（可选）
# ============================================

# scripts/compress-livephoto.mjs 使用的 ffmpeg 可执行文件路径
# 不配置时按以下顺序查找:ffmpeg-static 包 → 系统 PATH 中的 ffmpeg
# Windows 示例: "C:/ffmpeg/bin/ffmpeg.exe"
# 留空则依赖系统 PATH 或 ffmpeg-static
FFMPEG_PATH=""

# ============================================
# 高德地图 JS API 配置（旅行地图功能，可选）
# ============================================
# 申请地址：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建「Web端(JS API)」Key
AMAP_KEY=""
# JS API 2.0 安全密钥（创建 Key 后，在 Key 配置页获取）
AMAP_SECURITY_CODE=""
