# 生产环境需设置为 "production"
# NODE_ENV="production"

# 数据库连接相关配置，开发环境和生产环境都必须填写
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="your_username"
DB_PASSWORD="your_password"
DB_NAME="your_database_name"

# SSR 内部请求密钥，生产建议填写；不填则每次启动自动生成随机值、重启即更换
SSR_INTERNAL_REQUEST_SECRET=""

# 小程序服务端相关配置，若启用小程序功能这里必须填写
MINI_API_SECRET=""
WECHAT_MINI_APPID=""
WECHAT_MINI_SECRET=""

# 受信代理相关配置
TRUSTED_PROXY=""

# 上传策略设为本地时附件的上传位置
UPLOADS_DIR=""

# 登录安全密钥，不要与 SSR 请求密钥一致
LOGIN_SECRET=""

# 高德地图相关配置
AMAP_KEY=""
AMAP_SECURITY_CODE=""

# 腾讯云 COS 上传相关配置，仅 upload:cos 部署脚本使用
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
COS_CONCURRENCY=15

# 服务器上传相关配置，仅 upload:server 部署脚本使用
SERVER_HOST=""
SERVER_PORT="22"
SERVER_USER="root"
SERVER_PASSWORD=""
SERVER_UPLOAD_DIR=""
SERVER_UPLOAD_CONCURRENCY="8"

# Nginx 配置生成相关配置，仅 nginx:generate 部署脚本使用
DEPLOY_PORT=3000
DEPLOY_PROJECT_ROOT_DIR=/www/wwwroot/your-site
DEPLOY_SITE_DOMAIN=your-domain.com
DEPLOY_CDN_DOMAIN=cdn.your-domain.com
DEPLOY_ENABLE_CDN_REDIRECT=true

# 恢复真实客户端 IP，可选；填前端接入层的回源 IP 段（逗号分隔，支持 CIDR），留空则不恢复
DEPLOY_TRUSTED_PROXY=""
DEPLOY_REAL_IP_HEADER="X-Forwarded-For"

# 实况照片压缩相关配置，仅 compress:livephoto 部署脚本使用；留空则依次尝试 ffmpeg-static、系统 PATH
FFMPEG_PATH=""

# 宝塔面板相关配置，仅 restart-server / clear-redis 部署脚本使用
BT_PANEL_URL=""
BT_API_KEY=""
BT_PROJECT_NAME=""
