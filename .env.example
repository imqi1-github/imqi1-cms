# 生产环境需设置为 "production"
# NODE_ENV="production"

# 数据库连接相关配置，开发环境和生产环境都必须填写
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="your_username"
DB_PASSWORD="your_password"
DB_NAME="your_database_name"

# SSR 内部请求密钥，生产建议填写；不填则每次启动自动生成随机值、重启即更换
SSR_INTERNAL_REQUEST_SECRET=""

# 小程序服务端相关配置，若启用小程序功能这里必须填写
MINI_API_SECRET=""
WECHAT_MINI_APPID=""
WECHAT_MINI_SECRET=""

# MCP 运维工具令牌（可选）：配置后 /mcp 端点额外注册运维诊断工具（系统状态/日志/内容统计/缓存），
# 调用这些工具须携带本 token 入参；留空则运维工具完全不注册（fail-closed）。建议随机长字符串。
MCP_OPS_TOKEN=""

# 受信代理相关配置
TRUSTED_PROXY=""

# 上传策略设为本地时附件的上传位置
UPLOADS_DIR=""

# 日志落地目录（每类别一个子目录、按天分文件；总开关/大小切分/保留天数/分类开关见 site.config.ts logs 区）。
# 裸机部署指应用写日志的目录，留空默认 ./logs；Docker 部署指挂载日志的宿主目录（容器内路径 compose 固定），留空默认项目根 logs/
LOGS_DIR=""

# 登录安全密钥，不要与 SSR 请求密钥一致
LOGIN_SECRET=""

# 高德地图相关配置
AMAP_KEY=""
AMAP_SECURITY_CODE=""

# 腾讯云 COS 上传相关配置，仅 upload:cos 部署脚本使用
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
COS_CONCURRENCY=15

# CDN 边缘缓存刷新（EdgeOne），可选：配齐后内容变更会自动刷新受影响的页面
# EDGEONE_ZONE_ID=""                          # EdgeOne 站点 ID（形如 zone-xxxxxxxx），必填
# EDGEONE_SECRET_ID=""                       # 腾讯云 SecretId，与 COS 同账号时可填同一对密钥
# EDGEONE_SECRET_KEY=""
# EDGEONE_REGION=""                          # 可选，EdgeOne 地域，如 ap-guangzhou
# EDGEONE_API_HOST=""                        # 可选，国际站填 teo.intl.tencentcloudapi.com
# CDN_PROVIDER="edgeone"                     # 可选，默认按上面的 ZoneId+密钥自动识别为 edgeone
# CDN_AUTO_PURGE="0"                         # 可选，=0 关闭写库后自动刷新（默认开启：2 秒防抖 + 精确 URL，仅通配变更才用目录额度）
# CDN_PURGE_BASE_URL=""                      # 可选，覆盖 site.config 的 site.url（刷新用的主机）
# CDN_PURGE_SCOPE="route"                    # 可选，route=按路由精确刷（默认）；site=合并成根目录一条（省额度、多回源）
# CDN_PURGE_BATCH_SIZE=""                    # 可选，单次提交条数上限（默认按套餐实时读）
# CDN_PURGE_ON_STARTUP="0"                  # 可选，设为 0 关闭「构建变化时启动自动刷边缘」（默认开启，每次发版约消耗 1 个目录额度）

# 服务器上传相关配置，仅 upload:server 部署脚本使用
SERVER_HOST=""
SERVER_PORT="22"
SERVER_USER="root"
SERVER_PASSWORD=""
SERVER_UPLOAD_DIR=""
SERVER_UPLOAD_CONCURRENCY="8"

# Nginx 配置生成相关配置，仅 nginx:generate 部署脚本使用
DEPLOY_PORT=3000
DEPLOY_PROJECT_ROOT_DIR=/www/wwwroot/your-site
DEPLOY_SITE_DOMAIN=your-domain.com
DEPLOY_CDN_DOMAIN=cdn.your-domain.com
DEPLOY_ENABLE_CDN_REDIRECT=true

# 恢复真实客户端 IP，可选；填前端接入层的回源 IP 段（逗号分隔，支持 CIDR），留空则不恢复
DEPLOY_TRUSTED_PROXY=""
DEPLOY_REAL_IP_HEADER="X-Forwarded-For"
# real_ip_recursive：on=取 XFF 里最后一个「非受信」地址（多跳链）；off=取最后一个地址（单跳 CDN）。
# 填 0.0.0.0/0（信任全部）时自动用 off——全受信时 on 找不到非受信地址，所有访客 IP 会塌缩成 CDN 节点 IP
DEPLOY_REAL_IP_RECURSIVE=""

# 实况照片压缩相关配置，仅 compress:livephoto 部署脚本使用；留空则依次尝试 ffmpeg-static、系统 PATH
FFMPEG_PATH=""

# 宝塔面板相关配置，仅 restart-server / clear-redis 部署脚本使用
BT_PANEL_URL=""
BT_API_KEY=""
BT_PROJECT_NAME=""
