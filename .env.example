# 数据库连接（MySQL）

# 用于 Prisma Migrate (prisma migrate dev)
DATABASE_URL="mysql://root:your_password@localhost:3306/your_database_name"

# 用于 Prisma MariaDB Adapter (应用运行时)
# 注意：Adapter 使用拆分的参数，不支持 connection string
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="your_database_name"

# ============================================
# Redis 缓存配置（可选，用于 ISR 缓存）
# ============================================
#
# Redis 用于存储 ISR（增量静态再生成）缓存，可显著提升性能
# 如果不配置 Redis，缓存会自动降级到文件系统存储
#
# 配置说明：
# 开发环境（npm run dev）使用 REDIS_HOST_DEV 系列变量
# 生产环境（构建后的服务器）使用 REDIS_HOST_PROD 系列变量
#
# 开发环境 Redis 配置：
# - REDIS_HOST_DEV: 开发环境 Redis 服务器地址（如 127.0.0.1）
# - REDIS_PORT_DEV: 开发环境 Redis 端口，默认 6379
# - REDIS_PASSWORD_DEV: 开发环境 Redis 密码（如果有）
# - REDIS_DB_DEV: 开发环境 Redis 数据库编号，默认 0
#
# 生产环境 Redis 配置：
# - REDIS_HOST_PROD: 生产环境 Redis 服务器地址（如云服务地址）
# - REDIS_PORT_PROD: 生产环境 Redis 端口，默认 6379
# - REDIS_PASSWORD_PROD: 生产环境 Redis 密码（如果有）
# - REDIS_DB_PROD: 生产环境 Redis 数据库编号，默认 0
#
# 本地开发环境示例：
# REDIS_HOST_DEV="127.0.0.1"
# REDIS_PORT_DEV="6379"
# REDIS_PASSWORD_DEV=""
# REDIS_DB_DEV="0"
#
# 生产环境云服务 Redis 示例（如腾讯云）：
# REDIS_HOST_PROD="redis-xxxxx.cloud.tencent.com"
# REDIS_PORT_PROD="6379"
# REDIS_PASSWORD_PROD="your_cloud_redis_password"
# REDIS_DB_PROD="0"

# 开发环境 Redis 配置
REDIS_HOST_DEV=""
REDIS_PORT_DEV="6379"
REDIS_PASSWORD_DEV=""
REDIS_DB_DEV="0"

# 生产环境 Redis 配置
REDIS_HOST_PROD=""
REDIS_PORT_PROD="6379"
REDIS_PASSWORD_PROD=""
REDIS_DB_PROD="0"

# ============================================
# 根域名配置（生产环境必需）
# ============================================
#
# 用于：
# 1. 防止网站被反向代理到其他域名
# 2. sitemap.xml 等功能中生成正确的 URL（当请求头 host 为空时）
# 3. 其他需要获取站点域名的场景
#
# 如果设置了此值，当用户访问的域名与此值不匹配时，会强制跳转到此域名
#
# 示例：
# ROOT_DOMAIN="imqi1.com"
#
# 注意：
# - 此配置仅在生产环境生效（NODE_ENV=production）
# - 开发环境（npm run dev）不会启用此检查
# - 如果不设置此值，sitemap 可能生成错误的 URL（如 https:///xxx）
# - 请确保域名格式正确，不需要协议前缀（http:// 或 https://）

ROOT_DOMAIN=""

# 允许的referer域名（逗号分隔）
ALLOWED_REFERER_DOMAINS="imqi1.com"

# ============================================
# 生产环境种子数据配置 (NODE_ENV=production)
# ============================================

# 管理员账户
SEED_ADMIN_NAME="棋"
SEED_ADMIN_MAIL="imqi1@qq.com"
SEED_ADMIN_PASSWORD="123456"

# 网站基本信息
SEED_SITE_NAME="ImQi1"
SEED_SITE_URL="https://imqi1.com"
SEED_SITE_DESC="做技术的分享者、生活的摄影师、时事的评论员。"
SEED_SITE_KEYWORDS="棋,ImQi1,棋的小站,生活,科技,编程,学习"
SEED_SITE_ICP=""

# 评论设置
SEED_COMMENT_ENABLED="true"
SEED_COMMENT_MODERATION="false"
SEED_COMMENT_MARKDOWN="false"
SEED_COMMENT_AVATAR_SERVICE="gravatar"
SEED_COMMENT_PAGE_SIZE="10"
SEED_COMMENT_MAX_LEVEL="4"
SEED_COMMENT_REQUIRE_MAIL="true"
SEED_COMMENT_REQUIRE_LINK="false"
SEED_COMMENT_INTERVAL="60"

# 阅读设置
SEED_POST_PAGE_SIZE="12"

# 外观设置
SEED_HOME_CUSTOM_TEXT='<p>本站小程序上新，欢迎扫码体验，亦可在微信中搜索"ImQi1"。</p>'
SEED_STATIC_FILE_PATH="https://cdn.imqi1.com/static"
SEED_MUSIC_PLAYLIST_ID="9255074836 || netease"
SEED_PHOTO_CATEGORY_SLUG="shot"
SEED_PHOTO_COVER_SUFFIX=""
SEED_POST_COVER_SUFFIX=""

# 评论审核设置
SEED_MODERATION_API_TYPE="1"
SEED_BAIDU_APP_ID=""
SEED_BAIDU_API_KEY=""
SEED_BAIDU_SECRET_KEY=""
SEED_BAIDU_CHECK_ADMIN="false"

# 邮件配置
SEED_EMAIL_LOG_ENABLED="true"
SEED_EMAIL_PUSH_TYPE="none"
SEED_SMTP_HOST=""
SEED_SMTP_USER=""
SEED_SMTP_ADDRESS=""
SEED_SMTP_PASSWORD=""
SEED_SMTP_SECURE_MODE="tls"
SEED_SMTP_PORT="465"
SEED_SMTP_FROM_NAME=""
SEED_ADMIN_EMAIL=""
SEED_NOTIFY_ADMIN="false"

# ============================================
# 腾讯云 COS 上传配置
# ============================================

# COS 密钥配置
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""

# COS 上传路径前缀（可选）
# 例如设置为 "static" 则文件会上传到 bucket/static/ 路径下
COS_PREFIX=""
COS_CONCURRENCY=20

# ============================================
# 附件上传设置
# ============================================
SEED_UPLOAD_LOCATION="local"
SEED_UPYUN_DOMAIN="https://cdn.imqi1.com"
SEED_UPYUN_SERVICE=""
SEED_UPYUN_OPERATOR=""
SEED_UPYUN_PASSWORD=""
SEED_UPYUN_IMAGE_PROCESS="false"
SEED_UPYUN_THUMBNAIL_VERSION=""
SEED_UPYUN_OUTPUT_MODE=""
SEED_UPYUN_TOKEN_KEY=""
SEED_UPYUN_TOKEN_EXPIRE="1800"
