{
  "files": [],
  "compilerOptions": {
    // 部分路径是给 test 目录做别名导入的
    "paths": {
      "#shared": ["./shared"],
      "#shared/*": ["./shared/*"],
      "#server": ["./server"],
      "#server/*": ["./server/*"],
      "@": ["./app"],
      "@/*": ["./app/*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "~": ["./app"],
      "~/*": ["./app/*"]
    }
  },
  "references": [
    {
      "path": "./.nuxt/tsconfig.app.json"
    },
    {
      "path": "./.nuxt/tsconfig.server.json"
    },
    {
      "path": "./.nuxt/tsconfig.shared.json"
    },
    {
      "path": "./.nuxt/tsconfig.node.json"
    },
    {
      "path": "./test/tsconfig.json"
    }
  ]
}
