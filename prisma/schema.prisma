generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model attachments {
  aid                Int                  @id @default(autoincrement())
  type               String
  title              String
  url                String
  storage            String               @default("local")
  metadata           Json?
  create_time        DateTime             @default(now())
  contentattachments contentattachments[]
}

model metas {
  mid              Int                @id @default(autoincrement())
  name             String             @unique(map: "Metas_name_key")
  slug             String?            @unique(map: "Metas_slug_key")
  desc             String?
  type             String             @default("category")
  contentrelations contentrelations[]

  @@index([mid, type], map: "Metas_mid_type_idx")
}

model changelogs {
  id          Int      @id @default(autoincrement())
  content     String   @db.Text
  create_time DateTime @default(now())

  @@index([create_time], map: "Changelogs_create_time_idx")
}

model comments {
  coid        Int      @id @default(autoincrement())
  cid         Int
  name        String   @db.VarChar(255)
  mail        String?  @db.VarChar(255)
  link        String?  @db.VarChar(500)
  content     String   @db.Text
  create_time DateTime @default(now())
  status      Int      @default(0)
  parent_id   Int?
  agent       String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  content_ref contents @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "Comments_cid_fkey")

  @@index([cid], map: "Comments_cid_idx")
}

model links {
  id      Int     @id @default(autoincrement())
  name    String
  desc    String?
  link    String
  avatar  String?
  enabled Boolean @default(true)

  // 友链修改相关字段
  originalLinkId     Int? // 要替换的原始友链ID
  isModification     Boolean @default(false) // 是否为修改请求
  modificationStatus String? @default("pending") // 修改状态: pending/approved/rejected

  // 关联原友链
  originalLink  links?  @relation("LinkModifications", fields: [originalLinkId], references: [id])
  modifications links[] @relation("LinkModifications")
}

model informations {
  id    Int    @id @default(autoincrement())
  key   String @unique(map: "Informations_key_key")
  value String
}

model contents {
  cid              Int                  @id @default(autoincrement())
  title            String               @db.VarChar(255)
  slug             String?              @db.VarChar(255)
  desc             String?              @db.Text
  content          String?              @db.Text
  create_time      DateTime             @default(now())
  update_time      DateTime
  status           Int                  @default(1)
  comment_num      Int                  @default(0)
  many_covers      Boolean              @default(false)
  covers           String?              @db.Text
  show_toc         Boolean              @default(false)
  tags             String?              @db.VarChar(500)
  type             Int                  @default(0)
  uid              Int                  @default(1)
  attachments      contentattachments[]
  comments         comments[]
  travels          contenttravels[]
  user             users                @relation(fields: [uid], references: [uid], map: "Contents_uid_fkey")
  contentrelations contentrelations[]

  @@unique([slug, type], map: "Contents_slug_type_key")
  @@index([status, type, create_time], map: "Contents_status_type_create_time_idx")
  @@index([uid], map: "Contents_uid_idx")
}

model contentrelations {
  cid     Int
  mid     Int
  content contents @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "ContentRelation_cid_fkey")
  metas   metas    @relation(fields: [mid], references: [mid], onDelete: Cascade, map: "ContentRelation_mid_fkey")

  @@id([mid, cid])
  @@index([mid, cid], map: "ContentRelation_mid_cid_idx")
  @@index([cid], map: "ContentRelation_cid_idx")
}

model contentattachments {
  aid        Int
  cid        Int
  attachment attachments @relation(fields: [aid], references: [aid], onDelete: Cascade, map: "ContentAttachments_aid_fkey")
  content    contents    @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "ContentAttachments_cid_fkey")

  @@id([aid, cid])
  @@index([aid], map: "ContentAttachments_aid_idx")
  @@index([cid], map: "ContentAttachments_cid_idx")
}

model sessions {
  id          String   @id
  userId      Int
  authCode    String
  expires     DateTime
  create_time DateTime @default(now())
  data        String?

  @@index([expires], map: "Sessions_expires_idx")
  @@index([userId], map: "Sessions_userId_idx")
}

model subscribes {
  id             Int              @id @default(autoincrement())
  url            String
  name           String
  avatar         String?
  lastUpdated    DateTime?
  subscribeposts subscribeposts[]
}

model subscribeposts {
  id          Int        @id @default(autoincrement())
  subscribeId Int
  title       String     @db.VarChar(500)
  link        String     @unique(map: "SubscribePost_link_key") @db.VarChar(500)
  description String?    @db.Text
  content     String?    @db.Text
  author      String?    @db.VarChar(255)
  pubDate     DateTime?
  create_time DateTime   @default(now())
  subscribe   subscribes @relation(fields: [subscribeId], references: [id], onDelete: Cascade, map: "SubscribePost_subscribeId_fkey")

  @@index([subscribeId], map: "SubscribePost_subscribeId_idx")
}

model users {
  uid         Int      @id @default(autoincrement())
  name        String   @unique(map: "Users_name_key")
  nickname    String?
  avatar      String?
  mail        String   @unique(map: "Users_mail_key")
  password    String
  create_time DateTime @default(now())
  auth_code   String?

  // 两步验证（TOTP）：totp_secret 为 base32 密钥，启用后登录需第二因素
  totp_secret  String?
  totp_enabled Boolean @default(false)

  contents        contents[]
  trusted_devices trusted_devices[]
}

model trusted_devices {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceId   String   @unique
  name       String?
  ip         String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  create_time DateTime @default(now())

  user users @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId], map: "TrustedDevices_userId_idx")
}

model travels {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  desc        String?  @db.Text
  cover       String?  @db.VarChar(500)
  longitude   Float
  latitude    Float
  sort        Int      @default(0)
  enabled     Boolean  @default(true)
  create_time DateTime @default(now())

  contenttravels contenttravels[]

  @@index([sort], map: "Travels_sort_idx")
}

// 文章 ↔ 旅行地点 多对多关联表
model contenttravels {
  travel_id Int
  cid       Int
  travel    travels  @relation(fields: [travel_id], references: [id], onDelete: Cascade, map: "ContentTravels_travel_id_fkey")
  content   contents @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "ContentTravels_cid_fkey")

  @@id([travel_id, cid])
  @@index([travel_id], map: "ContentTravels_travel_id_idx")
  @@index([cid], map: "ContentTravels_cid_idx")
}
