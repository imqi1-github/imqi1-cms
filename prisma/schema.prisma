generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id      Int     @id @default(autoincrement())
  name    String
  desc    String?
  link    String
  avatar  String?
  enabled Boolean @default(true)
}

model Subscribe {
  id          Int             @id @default(autoincrement())
  url         String
  name        String
  avatar      String?
  lastUpdated DateTime?
  posts       SubscribePost[]
}

model SubscribePost {
  id          Int       @id @default(autoincrement())
  subscribeId Int
  title       String
  link        String    @unique
  description String?
  content     String?
  author      String?
  pubDate     DateTime?
  create_time DateTime  @default(now())
  subscribe   Subscribe @relation(fields: [subscribeId], references: [id], onDelete: Cascade)
}

model Changelog {
  id          Int      @id @default(autoincrement())
  class       String
  desc        String
  create_time DateTime @default(now())
}

model Post {
  cid         Int            @id @default(autoincrement())
  title       String
  slug        String?
  desc        String?
  content     String?
  create_time DateTime       @default(now())
  update_time DateTime       @updatedAt
  status      Int            @default(1)
  comment_num Int            @default(0)
  many_covers Boolean        @default(false)
  covers      String?
  show_toc    Boolean        @default(false)
  tags        String?
  type        Int            @default(0)
  uid         Int            @default(1)
  attachments Attachment[]
  comments    Comment[]
  user        User           @relation(fields: [uid], references: [uid])
  relations   PostRelation[]

  @@unique([slug, type])
}

model Comment {
  coid        Int      @id @default(autoincrement())
  cid         Int
  name        String
  mail        String?
  link        String?
  avatar      String?
  content     String
  create_time DateTime @default(now())
  status      Int      @default(0)
  parent_id   Int?
  agent       String?
  ip          String?
  post        Post     @relation(fields: [cid], references: [cid], onDelete: Cascade)
}

model Attachment {
  aid         Int      @id @default(autoincrement())
  cid         Int
  type        String
  title       String
  url         String
  storage     String   @default("local")
  create_time DateTime @default(now())
  post        Post     @relation(fields: [cid], references: [cid], onDelete: Cascade)
}

model Category {
  mid       Int            @id @default(autoincrement())
  name      String         @unique
  slug      String?        @unique
  desc      String?
  class     String?
  type      String         @default("category")
  relations PostRelation[]
}

model PostRelation {
  id       Int      @id @default(autoincrement())
  cid      Int
  mid      Int
  post     Post     @relation(fields: [cid], references: [cid], onDelete: Cascade)
  category Category @relation(fields: [mid], references: [mid], onDelete: Cascade)

  @@unique([cid, mid])
}

model User {
  uid       Int      @id @default(autoincrement())
  name      String   @unique
  nickname  String?
  avatar    String?
  mail      String   @unique
  password  String
  create    DateTime @default(now())
  auth_code String?
  role      Int      @default(0)
  posts     Post[]
}

model Meta {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Session {
  id        String   @id
  userId    Int
  authCode  String
  expires   DateTime
  createdAt DateTime @default(now())
  data      String?

  @@index([userId])
  @@index([expires])
}
