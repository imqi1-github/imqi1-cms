generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model attachments {
  aid         Int      @id @default(autoincrement())
  cid         Int
  type        String
  title       String
  url         String
  storage     String   @default("local")
  create_time DateTime @default(now())
  posts       posts    @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "Attachment_cid_fkey")

  @@index([cid], map: "Attachment_cid_fkey")
}

model metas {
  mid           Int             @id @default(autoincrement())
  name          String          @unique(map: "Metas_name_key")
  slug          String?         @unique(map: "Metas_slug_key")
  desc          String?
  type          String          @default("category")
  postrelations postrelations[]

  @@index([mid, type], map: "Metas_mid_type_idx")
}

model changelogs {
  id          Int      @id @default(autoincrement())
  class       String
  desc        String   @db.Text
  create_time DateTime @default(now())

  @@index([create_time], map: "Changelogs_create_time_idx")
}

model comments {
  coid        Int      @id @default(autoincrement())
  cid         Int
  name        String   @db.VarChar(255)
  mail        String?  @db.VarChar(255)
  link        String?  @db.VarChar(500)
  content     String   @db.Text
  create_time DateTime @default(now())
  status      Int      @default(0)
  parent_id   Int?
  agent       String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  posts       posts    @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "Comments_cid_fkey")

  @@index([cid], map: "Comments_cid_fkey")
}

model links {
  id      Int     @id @default(autoincrement())
  name    String
  desc    String?
  link    String
  avatar  String?
  enabled Boolean @default(true)

  // 友链修改相关字段
  originalLinkId     Int? // 要替换的原始友链ID
  isModification     Boolean @default(false) // 是否为修改请求
  modificationStatus String? @default("pending") // 修改状态: pending/approved/rejected

  // 关联原友链
  originalLink  links?  @relation("LinkModifications", fields: [originalLinkId], references: [id])
  modifications links[] @relation("LinkModifications")
}

model informations {
  id    Int    @id @default(autoincrement())
  key   String @unique(map: "Informations_key_key")
  value String
}

model posts {
  cid           Int             @id @default(autoincrement())
  title         String          @db.VarChar(255)
  slug          String?         @db.VarChar(255)
  desc          String?         @db.Text
  content       String?         @db.LongText
  create_time   DateTime        @default(now())
  update_time   DateTime
  status        Int             @default(1)
  comment_num   Int             @default(0)
  many_covers   Boolean         @default(false)
  covers        String?         @db.Text
  show_toc      Boolean         @default(false)
  tags          String?         @db.VarChar(500)
  type          Int             @default(0)
  uid           Int             @default(1)
  attachments   attachments[]
  comments      comments[]
  travels       posttravels[]
  user          users           @relation(fields: [uid], references: [uid], map: "Posts_uid_fkey")
  postrelations postrelations[]

  @@unique([slug, type], map: "Posts_slug_type_key")
  @@index([status, type, create_time], map: "Posts_status_type_create_time_idx")
  @@index([uid], map: "Posts_uid_fkey")
}

model postrelations {
  cid   Int
  mid   Int
  posts posts @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "PostRelation_cid_fkey")
  metas metas @relation(fields: [mid], references: [mid], onDelete: Cascade, map: "PostRelation_mid_fkey")

  @@id([mid, cid])
  @@index([mid, cid], map: "PostRelation_mid_cid_idx")
  @@index([cid], map: "PostRelation_cid_fkey")
}

model sessions {
  id        String   @id
  userId    Int
  authCode  String
  expires   DateTime
  createdAt DateTime @default(now())
  data      String?

  @@index([expires], map: "Sessions_expires_idx")
  @@index([userId], map: "Sessions_userId_idx")
}

model subscribes {
  id             Int              @id @default(autoincrement())
  url            String
  name           String
  avatar         String?
  lastUpdated    DateTime?
  subscribeposts subscribeposts[]
}

model subscribeposts {
  id          Int        @id @default(autoincrement())
  subscribeId Int
  title       String     @db.VarChar(500)
  link        String     @unique(map: "SubscribePost_link_key") @db.VarChar(500)
  description String?    @db.Text
  content     String?    @db.LongText
  author      String?    @db.VarChar(255)
  pubDate     DateTime?
  create_time DateTime   @default(now())
  subscribe   subscribes @relation(fields: [subscribeId], references: [id], onDelete: Cascade, map: "SubscribePost_subscribeId_fkey")

  @@index([subscribeId], map: "SubscribePost_subscribeId_fkey")
}

model users {
  uid       Int      @id @default(autoincrement())
  name      String   @unique(map: "Users_name_key")
  nickname  String?
  avatar    String?
  mail      String   @unique(map: "Users_mail_key")
  password  String
  create    DateTime @default(now())
  auth_code String?
  role      Int      @default(0)
  posts     posts[]
}

model travels {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  desc        String?  @db.Text
  cover       String?  @db.VarChar(500)
  longitude   Float
  latitude    Float
  sort        Int      @default(0)
  enabled     Boolean  @default(true)
  create_time DateTime @default(now())

  posts       posttravels[]

  @@index([sort], map: "Travels_sort_idx")
}

// 文章 ↔ 旅行地点 多对多关联表
model posttravels {
  travel_id Int
  cid       Int
  travel    travels @relation(fields: [travel_id], references: [id], onDelete: Cascade, map: "PostTravels_travel_id_fkey")
  post      posts   @relation(fields: [cid], references: [cid], onDelete: Cascade, map: "PostTravels_cid_fkey")

  @@id([travel_id, cid])
  @@index([travel_id], map: "PostTravels_travel_id_fkey")
  @@index([cid], map: "PostTravels_cid_fkey")
}
