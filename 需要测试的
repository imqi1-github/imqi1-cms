建议：把封面解析抽到 server/utils/covers.ts：

export function parseCovers(raw: string | null | undefined): Array<{ url: string; desc: string }> {
  if (!raw) return [];
  try {
    const parsed = JSON.parse(raw);
    if (Array.isArray(parsed)) {
      return parsed.map((item: any) => ({
        url: item.url || item,
        desc: item.title || item.desc || '',
      }));
    }
  } catch {
    return raw.split('\n').map(line => {
      const trimmed = line.trim();
      if (!trimmed) return null;
      if (trimmed.includes('||')) {
        const [url, desc] = trimmed.split('||');
        return { url: (url ?? '').trim(), desc: desc?.trim() || '' };
      }
      return { url: trimmed, desc: '' };
    }).filter(Boolean) as Array<{ url: string; desc: string }>;
  }
  return [];
}

