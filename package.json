{
  "name": "imqi1-nodejs",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-build-hash.mjs",
    "build": "npm run prebuild && node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs build",
    "build:upload": "npm run prebuild && node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs build && npm run upload:cos",
    "build:debug": "npm run prebuild && cross-env DEBUG=nuxt:*,nitro:* NODE_OPTIONS=--max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs build",
    "build:verbose": "node scripts/build-verbose.mjs",
    "build:progress": "npm run prebuild && node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs build --verbose",
    "postbuild": "node scripts/copy-data.mjs && node scripts/update-sw-cdn.mjs",
    "dev": "node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "build:preview": "node .outout/server/index.mjs",
    "postinstall": "nuxt prepare",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "tsx prisma/seed/migrate.ts",
    "upload:cos": "node scripts/upload-cos.mjs",
    "upload:cos:_nuxt": "node scripts/upload-cos.mjs _nuxt",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop imqi1-nuxt",
    "pm2:restart": "pm2 restart imqi1-nuxt",
    "pm2:reload": "pm2 reload imqi1-nuxt",
    "pm2:delete": "pm2 delete imqi1-nuxt",
    "pm2:logs": "pm2 logs imqi1-nuxt",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "deploy": "npm run build && npm run upload:cos"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.13",
    "@meting/core": "^1.6.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@shikijs/markdown-it": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "@tanstack/vue-table": "^8.21.3",
    "@types/nodemailer": "^7.0.11",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/core": "^14.2.1",
    "art-template": "^4.13.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^17.4.1",
    "fast-xml-parser": "^5.5.10",
    "floating-vue": "^5.2.2",
    "isomorphic-dompurify": "^3.8.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "nodemailer": "^8.0.4",
    "nuxt": "^4.4.2",
    "pm2": "^5.4.2",
    "promise-polyfill": "^8.3.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.3",
    "shadcn-nuxt": "^2.4.3",
    "smoothscroll": "^0.4.0",
    "ssh2-sftp-client": "^12.1.1",
    "swiper": "^12.1.3",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9"
  },
  "packageManager": "bun@1.3.10+30e609e08",
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.5",
    "@iconify-json/boxicons": "^1.2.0",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.101",
    "@iconify-json/material-icon-theme": "^1.2.58",
    "@iconify-json/material-symbols": "^1.2.66",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/vscode-icons": "^1.2.45",
    "@nuxt/icon": "^2.2.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.0",
    "@vue/compiler-sfc": "^3.5.31",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "mysql2": "^3.22.0",
    "postcss": "^8.5.8",
    "prisma": "^7.6.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-tsc": "^3.2.6"
  }
}
